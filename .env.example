# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Where poptávky (leads) are delivered
CONTACT_EMAIL=elevateitcz@gmail.com
# Sender. Without your own verified domain keep it empty — Resend then sends from
# onboarding@resend.dev, which only delivers to the e-mail of the Resend account
# (so register Resend with elevateitcz@gmail.com). With a verified domain use e.g. web@yourdomain.cz
CONTACT_FROM_EMAIL=
# Public site URL (used for metadata / sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://www.elevateit.cz
# Optional analytics — leave empty to keep analytics (and the cookie banner) off
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Supabase (obsah webu + administrace /admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# tajný klíč — jen na serveru, nikdy do klienta ani do gitu
SUPABASE_SERVICE_ROLE_KEY=
# kdo smí do administrace (čárkou oddělené e-maily)
ADMIN_EMAILS=
# Cloudflare Turnstile (ochrana formuláře proti spamu, bez obrázkové captchy)
# https://dash.cloudflare.com → Turnstile → Add widget (doména webu, režim Managed)
# Bez klíčů formulář funguje jen s honeypotem a limitem odeslání.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
