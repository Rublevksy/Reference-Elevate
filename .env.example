# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Where poptávky (leads) are delivered
CONTACT_EMAIL=info@elevate-studio.cz
# Verified sender domain in Resend (must be a domain you own)
CONTACT_FROM_EMAIL=web@elevate-studio.cz
# Public site URL (used for metadata / sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://www.elevate-studio.cz
# Optional analytics — leave empty to keep analytics (and the cookie banner) off
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
