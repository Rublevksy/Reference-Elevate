# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Where poptávky (leads) are delivered
CONTACT_EMAIL=elevateitcz@gmail.com
# Sender. Without your own verified domain keep it empty — Resend then sends from
# onboarding@resend.dev, which only delivers to the e-mail of the Resend account
# (so register Resend with elevateitcz@gmail.com). With a verified domain use e.g. web@yourdomain.cz
CONTACT_FROM_EMAIL=
# Public site URL (used for metadata / sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://www.elevate-studio.cz
# Optional analytics — leave empty to keep analytics (and the cookie banner) off
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
